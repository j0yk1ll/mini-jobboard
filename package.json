{
  "name": "mini-jobboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.25",
    "better-auth": "1.7.25",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-node": "6.0.4",
    "@sveltejs/kit": "3.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "prettier": "3.10.1",
    "prettier-plugin-svelte": "3.5.2",
    "svelte": "5.58.0",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
